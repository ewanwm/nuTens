"""
Defines some helpful units, which are really just conversion factors to eV
"""
from __future__ import annotations
__all__: list[str] = ['GeV', 'MeV', 'cm', 'eV', 'km', 'm']
GeV: float = 1000000000.0
MeV: float = 1000000.0
cm: float = 8065.54394
eV: float = 1.0
km: float = 806554394.0
m: float = 806554.394
